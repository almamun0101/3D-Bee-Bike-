NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dbee-ef05d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://dbee-ef05d-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dbee-ef05d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dbee-ef05d.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1034028465473
NEXT_PUBLIC_FIREBASE_APP_ID=1:1034028465473:web:7ab6752cc2138a29bd35c0

# Root node in Realtime Database (orders live at /<root>/orders)
NEXT_PUBLIC_DB_ROOT=3dbee v2
# Admin login (Firebase Auth email/password). Set to "false" only for local testing.
NEXT_PUBLIC_REQUIRE_LOGIN=true

# Steadfast Courier API credentials (server-side only; never use NEXT_PUBLIC_). Put the real values in .env.local / Netlify env vars, never in this file.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Optional: STEADFAST_BASE_URL, STEADFAST_ALLOWED_EMAIL

# ── Automation (background sync + webhook) - server-side only ──
# Firebase service-account JSON (Project settings > Service accounts > Generate new private key). Paste the JSON or its base64.
FIREBASE_SERVICE_ACCOUNT=
# Secret you choose; enter the same value as the Bearer token in the Steadfast webhook settings.
STEADFAST_WEBHOOK_TOKEN=
